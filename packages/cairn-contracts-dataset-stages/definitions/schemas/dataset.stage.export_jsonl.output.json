{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://dataset.stage.export_jsonl.output/1.0.0",
  "type": "object",
  "properties": {
    "output": {"type": "string", "description": "Path or s3:// URI of the export."},
    "format": {"const": "jsonl", "description": "Always jsonl."},
    "store": {"type": "string", "description": "Where the export landed."},
    "content_hash": {"type": "string", "description": "sha256 of the exported bytes."},
    "bytes": {"type": "integer", "minimum": 0, "description": "Size of the export."},
    "register_as": {"type": "string", "description": "Echo of the registration request."}
  },
  "required": ["output", "format", "store", "content_hash", "bytes"]
}
